{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/sesiones.mjs\" --registrar --hook",
            "timeout": 15,
            "statusMessage": "¿trabaja alguien más en este workspace?"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guardar-conversacion.mjs\" --hook",
            "timeout": 120,
            "statusMessage": "archivando conversaciones que quedaron sin guardar"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/sesiones.mjs\" --cerrar",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guardar-conversacion.mjs\" --hook",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/triage.mjs\" --hook",
            "timeout": 10,
            "statusMessage": "¿de qué clase es esta petición?"
          }
        ]
      }
    ]
  }
}
